<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Wall Rebar 2D"
    Height="460" Width="520"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Wall Rebar 2D" FontSize="15" FontWeight="Bold"/>
            <TextBlock x:Name="lblView" Text="" Foreground="#2E7D32" FontWeight="SemiBold"/>
            <TextBlock x:Name="lblExisting" Text="" Foreground="#555555" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Bar diameters allowed on this floor" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <WrapPanel>
                <CheckBox x:Name="d8"  Content="Ø8"  Width="66"/>
                <CheckBox x:Name="d10" Content="Ø10" Width="66"/>
                <CheckBox x:Name="d12" Content="Ø12" Width="66"/>
                <CheckBox x:Name="d14" Content="Ø14" Width="66"/>
                <CheckBox x:Name="d16" Content="Ø16" Width="66"/>
                <CheckBox x:Name="d18" Content="Ø18" Width="66"/>
                <CheckBox x:Name="d20" Content="Ø20" Width="66"/>
                <CheckBox x:Name="d22" Content="Ø22" Width="66"/>
                <CheckBox x:Name="d25" Content="Ø25" Width="66"/>
                <CheckBox x:Name="d28" Content="Ø28" Width="66"/>
                <CheckBox x:Name="d32" Content="Ø32" Width="66"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Minimum diameter at wall ends, mm:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="tbMinDia" Width="60" Height="23" VerticalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Stages (unticked = leave as is: nothing placed, changed or deleted)"
                       FontWeight="SemiBold" Margin="0,12,0,2"/>
            <CheckBox x:Name="cbRebar"    Content="1. Rebar dots: wall ends, inner rows, corners"/>
            <CheckBox x:Name="cbStirIn"   Content="1. Stirrup contour inside short walls (thin detail lines)"/>
            <CheckBox x:Name="cbStirDet"  Content="2. Stirrup details next to the wall (shape with dimensions)"/>
            <CheckBox x:Name="cbTags"     Content="3. Tags (existing tags are not moved)"/>
            <CheckBox x:Name="cbTagLines" Content="4. Tag lines to first / last bar (run after adjusting tags; re-run redraws)"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="lblStatus" TextWrapping="Wrap" Foreground="#777777"
                   FontSize="11" Margin="0,8,0,8"
                   Text="Everything else (zones, corners, openings, tags, families) is set inside the script."/>

        <DockPanel Grid.Row="3">
            <Button x:Name="btnCancel" DockPanel.Dock="Right" Content="Cancel" Padding="12,6" Margin="6,0,0,0"/>
            <Button x:Name="btnRun" DockPanel.Dock="Right" Content="Run" Padding="18,6" Margin="6,0,0,0"
                    Background="#1565C0" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnDry" DockPanel.Dock="Right" Content="Test run (no changes)" Padding="12,6" Margin="6,0,0,0"/>
            <TextBlock Text="" />
        </DockPanel>
    </Grid>
</Window>
