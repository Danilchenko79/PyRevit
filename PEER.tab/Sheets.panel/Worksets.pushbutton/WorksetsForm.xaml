<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Worksets &amp; Coordination Filters"
        Height="700" Width="720" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <!-- Row 0 holds the inputs (left) + wall-type reference (right);
         Row 1 (buttons) is pinned and can never be clipped. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: editable inputs -->
        <ScrollViewer Grid.Row="0" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Create Worksets &amp; Coordination Filters"
                           FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>

                <!-- Usage / instructions -->
                <Border Background="#F2F6FA" BorderBrush="#C6D4E1"
                        BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                    <TextBlock TextWrapping="Wrap" Foreground="#33475B">
                        <Run FontWeight="Bold" Text="How to use:"/><LineBreak/>
                        <Run Text="1. Edit the worksets list (one per line)."/><LineBreak/>
                        <Run Text="2. Type the text found in the CONCRETE wall type names. The list on the right shows the wall types in the links for reference. All other walls are treated as partitions."/><LineBreak/>
                        <Run Text="3. Tick the view templates that should receive the coordination filters."/><LineBreak/>
                        <Run Text="4. Click OK — worksets are created, then filters are built and pushed to the templates."/>
                    </TextBlock>
                </Border>

                <TextBlock Text="Worksets (one per line):" Margin="0,0,0,4"/>
                <TextBox x:Name="tb_worksets"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Height="120" FontFamily="Consolas"/>

                <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                           Text="CONCRETE wall type text (comma-separated substrings, e.g. CON). Every wall whose type name contains none of these is treated as a partition and recoloured separately:"/>
                <TextBox x:Name="tb_concrete"/>

                <TextBlock Margin="0,12,0,4"
                           Text="View templates to update (tick to include):"/>
                <Border BorderBrush="#BBBBBB" BorderThickness="1" Background="White" Height="150">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="templates_panel" Margin="6,4,6,4"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: read-only reference list of wall types found in the links -->
        <DockPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Wall types in links (reference):"
                       FontWeight="SemiBold" FontSize="11" Foreground="#5A6A78"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="tb_walltypes"
                     IsReadOnly="True" IsTabStop="False"
                     Background="#FAFAFA" BorderBrush="#BBBBBB"
                     FontFamily="Consolas" FontSize="10" Foreground="#444444"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>

        <!-- Pinned bottom bar: checkboxes + OK/Cancel always visible -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Vertical" Margin="0,12,0,0">
            <CheckBox x:Name="cb_filters" Content="Create / update coordination filters" Margin="0,2"/>
            <CheckBox x:Name="cb_worksharing" Content="Auto-enable worksharing if it is off" Margin="0,2"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="OK" Width="90" Height="28" Click="on_ok" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Height="28" Click="on_cancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
