<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - Account"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <StackPanel Margin="20">
        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Your PEER account on this computer"/>

        <Border Margin="0,12,0,0" Background="White" BorderBrush="#D6D3D1" BorderThickness="1" Padding="14">
            <StackPanel>
                <Border x:Name="chip" HorizontalAlignment="Left" CornerRadius="4" BorderThickness="1"
                        Padding="8,2,8,3" Background="#F5F5F4" BorderBrush="#44403C">
                    <TextBlock x:Name="chip_text" FontWeight="SemiBold" Text="Not signed in"/>
                </Border>
                <TextBlock x:Name="status_text" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#44403C"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,3" Foreground="#57534E" Text="Name"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,3" x:Name="name_text" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Margin="0,3" Foreground="#57534E" Text="Role"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3" x:Name="role_text"/>
                    <TextBlock Grid.Row="2" Margin="0,3" Foreground="#57534E" Text="Key"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" x:Name="key_text" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="3" Margin="0,3" Foreground="#57534E" Text="Last check"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3" x:Name="last_text"/>
                    <TextBlock Grid.Row="4" Margin="0,3" Foreground="#57534E" Text="PEER version"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,3" x:Name="version_text"/>
                    <TextBlock Grid.Row="5" Margin="0,3" Foreground="#57534E" Text="Service"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,3" x:Name="service_text"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#57534E"
                   Text="One personal key opens the PEER buttons and the family library. It is stored encrypted for your Windows user on this computer only. Without internet PEER keeps working for 14 days after the last check."/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="signin_btn" Grid.Column="0" Content="Sign in / request access…" Padding="14,6"
                    Foreground="White" Background="#111827" BorderBrush="#111827" FontWeight="SemiBold"
                    Click="on_signin"/>
            <Button x:Name="check_btn" Grid.Column="1" Content="Check now" Margin="8,0,0,0" Padding="14,6"
                    Background="White" BorderBrush="#111827" Click="on_check"/>
            <Button x:Name="signout_btn" Grid.Column="2" Content="Sign out" Margin="8,0,0,0" Padding="14,6"
                    Background="White" BorderBrush="#78716C" Click="on_signout"/>
            <Button Grid.Column="4" Content="Close" Padding="14,6" IsCancel="True"
                    Background="White" BorderBrush="#78716C" Click="on_close"/>
        </Grid>
    </StackPanel>
</Window>
