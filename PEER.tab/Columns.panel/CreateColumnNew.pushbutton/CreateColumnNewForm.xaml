<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Column (new)"
        Height="760" Width="1180" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <!-- Row 0: title + how-to. Row 1: inputs. Row 2: table | sketch + messages.
         Row 3: problem columns. Row 4: pinned buttons. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Create Column (new)" FontWeight="Bold" FontSize="15"/>
            <Border Background="#F2F6FA" BorderBrush="#C6D4E1" BorderThickness="1" CornerRadius="3"
                    Padding="8" Margin="0,8,0,0">
                <TextBlock Foreground="#33475B" TextWrapping="Wrap">
                    One row = the columns of the level with the same section and reinforcement. Edit the
                    bars here - they are written back to the 3D columns. Stirrup and ties follow SI 466:
                    leave Stirrup D empty for the smallest allowed. The sketch and the messages show the
                    selected row: red - the drawing may not be issued, yellow - check it.
                </TextBlock>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Level (PR_Level)" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="1" x:Name="cb_level" SelectionChanged="on_level_changed"/>
            <TextBlock Grid.Column="2" Text="Drafting view" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox Grid.Column="3" x:Name="tb_view" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Sheet width, cm" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox Grid.Column="5" x:Name="tb_width" VerticalContentAlignment="Center"/>
            <Button Grid.Column="7" x:Name="btn_refresh" Content="Refresh" Width="90" Height="26"
                    Click="on_refresh" ToolTip="Read the columns from the model again"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" x:Name="dg_groups" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E8EE"
                      SelectionChanged="on_row_selected" CellEditEnding="on_cell_edit_ending">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Shape" Binding="{Binding ShapeText}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="Marks" Binding="{Binding Marks}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="b / h, mm" Binding="{Binding Size}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Bar D" Binding="{Binding Dia}" Width="55"/>
                    <DataGridTextColumn Header="Bars b" Binding="{Binding Qb}" Width="55"/>
                    <DataGridTextColumn Header="Bars h" Binding="{Binding Qh}" Width="55"/>
                    <DataGridTextColumn Header="Stirrup D" Binding="{Binding Stirrup}" Width="70"/>
                    <DataGridComboBoxColumn x:Name="col_mode" Header="Hold bars by"
                                            SelectedItemBinding="{Binding Mode}" Width="95"/>
                    <DataGridComboBoxColumn x:Name="col_contour" Header="Rounded contour"
                                            SelectedItemBinding="{Binding Contour}" Width="110"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" IsReadOnly="True" Width="2*"/>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#2A8A3A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="yellow">
                                                    <Setter Property="Fill" Value="#D9A21B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="red">
                                                    <Setter Property="Fill" Value="#D0302F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="tb_selected" FontWeight="SemiBold" Text="Select a row"
                           TextWrapping="Wrap"/>
                <Border Grid.Row="1" BorderBrush="#C6D4E1" BorderThickness="1" Margin="0,6,0,6" Background="White">
                    <Viewbox Stretch="Uniform" Margin="4">
                        <Canvas x:Name="cv_sketch" Width="300" Height="300"/>
                    </Viewbox>
                </Border>
                <TextBlock Grid.Row="2" x:Name="tb_label" Foreground="#33475B" TextWrapping="Wrap"/>
                <ItemsControl Grid.Row="3" x:Name="ic_messages" Margin="0,6,0,0"/>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#FBF6EC" BorderBrush="#E5D3AE" BorderThickness="1" CornerRadius="3"
                Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="tb_problems" VerticalAlignment="Center" Foreground="#6B4E16"/>
                <Button x:Name="btn_sel_nomark" Content="Select without mark" Margin="12,0,0,0" Padding="8,2"
                        Click="on_select_nomark"/>
                <Button x:Name="btn_sel_dups" Content="Select duplicate marks" Margin="6,0,0,0" Padding="8,2"
                        Click="on_select_dups"/>
                <Button x:Name="btn_sel_nolevel" Content="Select without PR__Level" Margin="6,0,0,0" Padding="8,2"
                        Click="on_select_nolevel"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="btn_split" Content="Split row by marks" HorizontalAlignment="Left" Height="28"
                    Padding="10,0" Click="on_split"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Create" Width="90" Height="28" IsDefault="True" Click="on_ok"/>
                <Button Content="Cancel" Width="90" Height="28" Margin="8,0,0,0" IsCancel="True" Click="on_cancel"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
