<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Column"
        Height="740" Width="720" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <!-- Row 0: title + how-to + global inputs (level, sheet width, cover, view).
         Row 1: editable groups table (fills the rest).
         Row 2: problem columns table (no mark / no level).
         Row 3: pinned OK/Cancel. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: title + help icons, global inputs.
             Инструкция и легенда армирования живут в попапах за иконками
             (CreateColumnInstructions.xaml / CreateColumnRebarHelp.xaml). -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Create Column" FontWeight="Bold" FontSize="15"
                           VerticalAlignment="Center"/>
                <Button x:Name="btn_help_info" Width="22" Height="22" Margin="10,0,0,0"
                        ToolTip="How to use" Cursor="Hand" Click="on_help_instructions">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="#EAF1F8" Stroke="#4A7AB5" StrokeThickness="1.2"/>
                                <TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold"
                                           FontStyle="Italic" Foreground="#2F5D93" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,0,0,1"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="btn_help_rebar" Width="22" Height="22" Margin="6,0,0,0"
                        ToolTip="Reinforcement legend - what each parameter means"
                        Cursor="Hand" Click="on_help_rebar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="#FBF3E4" Stroke="#C08A2D" StrokeThickness="1.2"/>
                                <TextBlock Text="?" FontWeight="Bold" Foreground="#9A6D1B"
                                           FontSize="13" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,0,0,1"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Global inputs -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Level (PR_Level):" VerticalAlignment="Center"
                           Margin="0,0,8,0" Grid.Row="0" Grid.Column="0"/>
                <ComboBox x:Name="cb_level" Height="24" Grid.Row="0" Grid.Column="1"
                          SelectionChanged="on_level_changed"/>

                <TextBlock Text="Drafting View:" VerticalAlignment="Center"
                           Margin="0,0,8,0" Grid.Row="0" Grid.Column="3"/>
                <TextBox x:Name="tb_view" Text="Column 150" Grid.Row="0" Grid.Column="4"/>

                <TextBlock Text="Sheet width (cm):" VerticalAlignment="Center"
                           Margin="0,8,8,0" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="tb_width" Text="59.4" Margin="0,8,0,0"
                         Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="Cover (cm):" VerticalAlignment="Center"
                           Margin="0,8,8,0" Grid.Row="1" Grid.Column="3"/>
                <TextBox x:Name="tb_cover" Text="2.5" Margin="0,8,0,0"
                         Grid.Row="1" Grid.Column="4"/>

                <TextBlock Text="Stirrup Ø (mm):" VerticalAlignment="Center"
                           Margin="0,8,8,0" Grid.Row="2" Grid.Column="0"/>
                <TextBox x:Name="tb_stirrup_dia" Text="8" Margin="0,8,0,0"
                         Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="Staple 62 Ø (mm):" VerticalAlignment="Center"
                           Margin="0,8,8,0" Grid.Row="2" Grid.Column="3"/>
                <TextBox x:Name="tb_staple_dia" Text="10" Margin="0,8,0,0"
                         Grid.Row="2" Grid.Column="4"/>
            </Grid>

            <TextBlock Text="Column groups on this level:" FontWeight="SemiBold"
                       Foreground="#5A6A78" Margin="0,4,0,4"/>
        </StackPanel>

        <!-- MIDDLE: editable groups table -->
        <DataGrid Grid.Row="1" x:Name="dg_groups"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionUnit="Cell" RowHeaderWidth="0"
                  CellEditEnding="on_cell_edit_ending"
                  AlternatingRowBackground="#F6F8FA">
            <DataGrid.Columns>
                <!-- Эскиз формы сечения (вертикальный): код в колонке Shape
                     (RECT/ROUND2/ROUND1) переключает геометрию через DataTrigger. -->
                <DataGridTemplateColumn Header="" Width="38" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Path x:Name="shapePath" Stroke="#44576A" StrokeThickness="1.4"
                                  Fill="Transparent" Width="15" Height="30" Margin="4,3"
                                  Stretch="Uniform" StrokeLineJoin="Round"
                                  ToolTip="Rectangular"
                                  Data="M 0,0 H 20 V 40 H 0 Z"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Shape}" Value="ROUND2">
                                    <Setter TargetName="shapePath" Property="Data"
                                            Value="M 0,10 A 10,10 0 0 1 20,10 V 30 A 10,10 0 0 1 0,30 Z"/>
                                    <Setter TargetName="shapePath" Property="ToolTip"
                                            Value="Rounded both sides"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Shape}" Value="ROUND1">
                                    <Setter TargetName="shapePath" Property="Data"
                                            Value="M 0,40 V 10 A 10,10 0 0 1 20,10 V 40 Z"/>
                                    <Setter TargetName="shapePath" Property="ToolTip"
                                            Value="Rounded one side"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Марки: группа из нескольких марок — синяя ссылка, клик
                     разбивает её на отдельные строки (on_split_group). -->
                <DataGridTemplateColumn Header="Mark" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="tbMarks" Text="{Binding Marks}"
                                           VerticalAlignment="Center" Margin="4,0"/>
                                <Button x:Name="btnSplit" Tag="{Binding RowIdx}"
                                        Visibility="Collapsed" Cursor="Hand"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Padding="4,0"
                                        ToolTip="Same reinforcement - marks are grouped. Click to split and edit each mark separately.">
                                    <TextBlock x:Name="tbMarksLink" Text="{Binding Marks}"
                                               Foreground="#2F5D93"
                                               TextDecorations="Underline"/>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CanSplit}" Value="1">
                                    <Setter TargetName="tbMarks" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="btnSplit" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Марка-дубль на уровне: красным (и текст, и ссылка). -->
                                <DataTrigger Binding="{Binding HasDup}" Value="1">
                                    <Setter TargetName="tbMarks" Property="Foreground" Value="#C0392B"/>
                                    <Setter TargetName="tbMarks" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="tbMarks" Property="ToolTip"
                                            Value="Duplicate mark on this level - fix the numbering (see the problem table below)"/>
                                    <Setter TargetName="tbMarksLink" Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="B / H (cm)" Binding="{Binding Size}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Rebar_Diameter (mm)" Binding="{Binding DiaMM}" Width="130"/>
                <DataGridTextColumn Header="Rebar Quantity_B" Binding="{Binding RebarX}" Width="120"/>
                <DataGridTextColumn Header="Rebar Quantity_H" Binding="{Binding RebarY}" Width="120"/>
                <DataGridTextColumn Header="Rebar_Quantity" Binding="{Binding Total}" IsReadOnly="True" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PROBLEM COLUMNS: no mark on this level / no PR_Level (review) -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="tb_problems_title" Text="Columns without mark on this level:"
                       FontWeight="SemiBold" Foreground="#B54708" Margin="0,0,0,4"/>
            <DataGrid x:Name="dg_problems" MaxHeight="160" MinHeight="60"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      SelectionUnit="FullRow" RowHeaderWidth="0"
                      VerticalScrollBarVisibility="Auto"
                      AlternatingRowBackground="#FBF6F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mark / Group" Binding="{Binding Mark}" Width="*"/>
                    <DataGridTextColumn Header="B / H (cm)" Binding="{Binding Size}" Width="90"/>
                    <DataGridTextColumn Header="Top Level" Binding="{Binding TopLevel}" Width="120"/>
                    <DataGridTextColumn Header="Id" Binding="{Binding IdStr}" Width="80"/>
                    <DataGridTemplateColumn Header="" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Select" Height="20" FontSize="11"
                                        Tag="{Binding IdStr}" Visibility="{Binding BtnVis}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- BOTTOM: pinned buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" Height="28" Click="on_ok" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Height="28" Click="on_cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
