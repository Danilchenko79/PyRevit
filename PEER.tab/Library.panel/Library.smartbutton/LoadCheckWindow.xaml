<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <!-- What replacing a family in the project changes: filled from lib/peer_library/ui_check.py -->
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Plain" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="head" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Border x:Name="verdict_box" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="verdict" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="summary" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid x:Name="pictures" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="pic_project_label" FontSize="12" FontWeight="SemiBold" Foreground="#44403C"/>
                <Border Background="White" BorderBrush="#D6D3D1" BorderThickness="1" CornerRadius="6"
                        Height="200" Margin="0,4,0,0">
                    <Grid>
                        <Image x:Name="pic_project" Stretch="Uniform" Margin="8"/>
                        <TextBlock x:Name="pic_project_none" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#78716C" FontSize="12"/>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="pic_library_label" FontSize="12" FontWeight="SemiBold" Foreground="#44403C"/>
                <Border Background="White" BorderBrush="#D6D3D1" BorderThickness="1" CornerRadius="6"
                        Height="200" Margin="0,4,0,0">
                    <Grid>
                        <Image x:Name="pic_library" Stretch="Uniform" Margin="8"/>
                        <TextBlock x:Name="pic_library_none" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#78716C" FontSize="12"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="list_label" Margin="0,14,0,4" FontSize="12" FontWeight="SemiBold" Foreground="#44403C"/>
        <Border Background="White" BorderBrush="#D6D3D1" BorderThickness="1" CornerRadius="6">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="10,6">
                <StackPanel x:Name="findings"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="hint" Margin="0,10,0,0" FontSize="12" Foreground="#44403C" TextWrapping="Wrap"/>
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="update_btn" DockPanel.Dock="Left" Style="{StaticResource Btn}" Click="on_update"/>
            <Button x:Name="aside_btn" DockPanel.Dock="Left" Style="{StaticResource Plain}" Click="on_aside"/>
            <Button x:Name="cancel_btn" DockPanel.Dock="Left" Style="{StaticResource Plain}" Click="on_cancel"/>
            <Button x:Name="copy_btn" DockPanel.Dock="Right" Style="{StaticResource Plain}" Margin="0"
                    Click="on_copy"/>
        </DockPanel>
    </StackPanel>
</Window>
