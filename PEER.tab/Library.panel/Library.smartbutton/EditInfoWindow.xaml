<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER Library - edit family info"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <StackPanel Margin="18">
        <TextBlock x:Name="head" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,4,0,0" Foreground="#44403C" FontSize="12" TextWrapping="Wrap"
                   Text="Changes the card only: no new version, the family file and projects are not touched."/>
        <TextBlock Margin="0,12,0,3" FontWeight="SemiBold" FontSize="12" Text="Display name"/>
        <TextBox x:Name="name_box" Padding="6,4" BorderBrush="#78716C"/>
        <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" FontSize="12" Text="Group"/>
        <ComboBox x:Name="group_box"/>
        <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" FontSize="12" Text="Tags (comma separated) - search finds them"/>
        <TextBox x:Name="tags_box" Padding="6,4" BorderBrush="#78716C"/>
        <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" FontSize="12" Text="Description: when to use, what to fill in"/>
        <TextBox x:Name="desc_box" Height="80" Padding="6,4" BorderBrush="#78716C" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" FontSize="12" Text="Link to instructions"/>
        <TextBox x:Name="help_box" Padding="6,4" BorderBrush="#78716C"/>
        <TextBlock x:Name="status_text" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#7F1D1D"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Save" Padding="16,6" Foreground="White" Background="#111827" BorderBrush="#111827"
                    FontWeight="SemiBold" Click="on_ok"/>
            <Button Content="Cancel" Padding="16,6" Margin="8,0,0,0" Background="White" BorderBrush="#78716C"
                    Click="on_cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
