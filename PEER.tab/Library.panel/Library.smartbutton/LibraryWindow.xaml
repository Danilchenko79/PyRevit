<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - Family library"
        Height="780" Width="1240" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <!-- Strings and tiles are set from lib/peer_library/ui_library.py (strings.py). -->
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#111827"/>
        <SolidColorBrush x:Key="Line" Color="#D6D3D1"/>
        <SolidColorBrush x:Key="Muted" Color="#57534E"/>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#374151"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A8A29E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="White" BorderThickness="1.5"
                                BorderBrush="#111827" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E7E5E4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A8A29E"/>
                                <Setter Property="Foreground" Value="#A8A29E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- search -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="category_box" Grid.Column="1" Width="190" Margin="10,0,0,0"
                      VerticalContentAlignment="Center" SelectionChanged="on_filter"/>
            <CheckBox x:Name="catalog_only" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                      Checked="on_filter" Unchecked="on_filter"/>
            <ComboBox x:Name="sort_box" Grid.Column="3" Width="130" Margin="10,0,0,0"
                      VerticalContentAlignment="Center" SelectionChanged="on_sort"/>
            <Border CornerRadius="6" Background="White" BorderBrush="#111827" BorderThickness="1.5">
                <Grid>
                    <TextBlock x:Name="search_hint" Margin="10,7" Foreground="#78716C"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="search_box" BorderThickness="0" Background="Transparent"
                             Padding="8,7" FontSize="14" TextChanged="on_search"/>
                </Grid>
            </Border>
            <TextBlock x:Name="user_text" Grid.Column="4" Margin="14,0,0,0"
                       VerticalAlignment="Center" Foreground="#57534E"/>
        </Grid>

        <TabControl x:Name="tabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    SelectionChanged="on_tab">
            <TabItem x:Name="tab_library" Header="Library">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="group_list" Grid.Column="0" BorderBrush="#D6D3D1"
                             SelectionChanged="on_group" Background="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                    <ListBox x:Name="tile_list" Grid.Column="1" Margin="10,0" BorderBrush="#D6D3D1"
                             Background="White" SelectionChanged="on_tile"
                             MouseDoubleClick="on_double"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Border Grid.Column="2" Background="White" BorderBrush="#D6D3D1" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="d_empty" Margin="28" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#57534E" LineHeight="20"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="details" Margin="14">
                                    <Border Height="200" Background="#FAFAF9" BorderBrush="#E7E5E4"
                                            BorderThickness="1">
                                        <Grid>
                                            <Image x:Name="d_image" Stretch="Uniform" Margin="6"/>
                                            <TextBlock x:Name="d_noimage" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="#78716C"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="d_name" FontSize="17" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="d_id" Foreground="#57534E" TextWrapping="Wrap"/>
                                    <Button x:Name="fav_btn" Style="{StaticResource Secondary}" Padding="10,3"
                                            Margin="0,8,0,0" HorizontalAlignment="Left" Click="on_fav"/>
                                    <WrapPanel x:Name="d_chips" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="d_version" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="d_project" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="d_desc" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="d_tags" Margin="0,6,0,0" Foreground="#57534E"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="d_help" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="d_stats" Margin="0,6,0,0" Foreground="#57534E"
                                               TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="issue_btn" Style="{StaticResource Secondary}" Padding="8,2"
                                                Margin="0,0,6,6" Click="on_issue"/>
                                    </WrapPanel>
                                    <Border x:Name="admin_panel" Background="#FAFAF9" BorderBrush="#D6D3D1"
                                            BorderThickness="1" Padding="8" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="admin_header" FontWeight="SemiBold" FontSize="11.5"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button x:Name="newver_btn" Style="{StaticResource Secondary}" Padding="8,2"
                                                        Margin="0,0,6,6" Click="on_new_version"/>
                                                <Button x:Name="edit_btn" Style="{StaticResource Secondary}" Padding="8,2"
                                                        Margin="0,0,6,6" Click="on_edit_info"/>
                                                <Button x:Name="coll_add_btn" Style="{StaticResource Secondary}" Padding="8,2"
                                                        Margin="0,0,6,6" Click="on_coll_add"/>
                                                <Button x:Name="coll_remove_btn" Style="{StaticResource Secondary}" Padding="8,2"
                                                        Margin="0,0,6,6" Click="on_coll_remove"/>
                                                <Button x:Name="deprecate_btn" Style="{StaticResource Secondary}" Padding="8,2"
                                                        Margin="0,0,6,6" Click="on_deprecate"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="types_panel">
                                        <TextBlock x:Name="types_header" Style="{StaticResource H}"/>
                                        <TextBlock x:Name="types_hint" Foreground="#57534E" FontSize="11.5"
                                                   TextWrapping="Wrap"/>
                                        <TextBox x:Name="types_search" Margin="0,4" Padding="4,3"
                                                 TextChanged="on_types_search"/>
                                        <ListBox x:Name="types_list" Height="170" BorderBrush="#D6D3D1"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button x:Name="types_all" Content="All" Style="{StaticResource Secondary}"
                                                    Padding="8,2" Click="on_types_all"/>
                                            <Button x:Name="types_none" Content="None" Style="{StaticResource Secondary}"
                                                    Padding="8,2" Click="on_types_none"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock x:Name="history_header" Style="{StaticResource H}"/>
                                    <StackPanel x:Name="d_history"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Margin="14,8,14,14">
                                <StackPanel x:Name="comp_panel" Margin="0,0,0,8" Visibility="Collapsed">
                                    <TextBlock x:Name="comp_header" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                    <StackPanel x:Name="comp_list"/>
                                </StackPanel>
                                <CheckBox x:Name="overwrite_box" Margin="0,0,0,6"/>
                                <CheckBox x:Name="all_docs_box" Margin="0,0,0,10" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="load_btn" Style="{StaticResource Primary}" Click="on_load"/>
                                    <Button x:Name="place_btn" Style="{StaticResource Secondary}" Click="on_place"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="tab_project" Header="This project">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="proj_summary" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="proj_filter" Width="220" Margin="14,0,0,0" SelectionChanged="on_proj_filter"/>
                    </StackPanel>
                    <ListView x:Name="proj_list" Grid.Row="1" BorderBrush="#D6D3D1" SelectionMode="Extended"
                              Foreground="#111827">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Family" Width="330" DisplayMemberBinding="{Binding family}"/>
                                <GridViewColumn Header="Category" Width="170" DisplayMemberBinding="{Binding category}"/>
                                <GridViewColumn Header="Status" Width="230" DisplayMemberBinding="{Binding status}"/>
                                <GridViewColumn Header="In project" Width="80" DisplayMemberBinding="{Binding pv}"/>
                                <GridViewColumn Header="Library" Width="80" DisplayMemberBinding="{Binding lv}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="proj_update_btn" Style="{StaticResource Primary}" Click="on_proj_update"/>
                        <Button x:Name="proj_propose_btn" Style="{StaticResource Secondary}" Click="on_proj_propose"/>
                        <Button x:Name="proj_refresh_btn" Style="{StaticResource Secondary}" Click="on_proj_refresh"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="tab_news" Header="What's new">
                <ListBox x:Name="news_list" Margin="0,8,0,0" BorderBrush="#D6D3D1" Background="White"/>
            </TabItem>
            <TabItem x:Name="tab_mine" Header="My proposals">
                <ListBox x:Name="mine_list" Margin="0,8,0,0" BorderBrush="#D6D3D1" Background="White"/>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="status_text" Foreground="#44403C" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="coll_load_btn" Grid.Column="1" Style="{StaticResource Primary}" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="on_coll_load"/>
            <Button x:Name="update_all_btn" Grid.Column="2" Style="{StaticResource Primary}" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="on_update_all"/>
            <Button x:Name="request_btn" Grid.Column="3" Style="{StaticResource Secondary}" Margin="8,0,0,0"
                    Click="on_request"/>
        </Grid>
    </Grid>
</Window>
