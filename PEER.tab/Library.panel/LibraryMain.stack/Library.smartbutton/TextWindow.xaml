<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <!-- Request a family / report a problem: texts are set from ui_dialogs.py -->
    <StackPanel Margin="18">
        <TextBlock x:Name="head" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="hint" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#44403C" FontSize="12"/>
        <TextBlock x:Name="label1" Margin="0,12,0,3" FontWeight="SemiBold" FontSize="12"/>
        <TextBox x:Name="box1" Padding="6,4" BorderBrush="#78716C"/>
        <TextBlock x:Name="label2" Margin="0,10,0,3" FontWeight="SemiBold" FontSize="12"/>
        <TextBox x:Name="box2" Height="90" Padding="6,4" BorderBrush="#78716C" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="status_text" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#7F1D1D"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ok_btn" Padding="16,6" Foreground="White" Background="#111827" BorderBrush="#111827"
                    FontWeight="SemiBold" Click="on_ok"/>
            <Button Content="Cancel" Padding="16,6" Margin="8,0,0,0" Background="White" BorderBrush="#78716C"
                    Click="on_cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
