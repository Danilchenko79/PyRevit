<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER Library - sign in"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <StackPanel Margin="20">
        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Sign in to the PEER library"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#44403C"
                   Text="Paste the personal key you got from a library admin (starts with peer_). It is stored encrypted for your Windows user on this computer only."/>
        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" FontSize="12" Text="Library key"/>
        <PasswordBox x:Name="key_box" Padding="6,5" BorderBrush="#111827"/>
        <TextBlock x:Name="status_text" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="ok_btn" Content="Sign in" Padding="16,6" Foreground="White"
                    Background="#111827" BorderBrush="#111827" FontWeight="SemiBold" Click="on_ok"/>
            <Button Content="Cancel" Padding="16,6" Margin="8,0,0,0" Background="White"
                    BorderBrush="#111827" Click="on_cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
