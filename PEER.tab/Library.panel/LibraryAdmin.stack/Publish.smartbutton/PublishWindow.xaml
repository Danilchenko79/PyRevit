<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - Publish to the library"
        Height="800" Width="720" MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <Window.Resources>
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#78716C"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="#111827" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lbl_file" Style="{StaticResource L}" Text="Family file (.rfa)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="file_box" TextChanged="on_file_changed"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource Secondary}"
                            Margin="8,0,0,0" Padding="10,4" Click="on_browse"/>
                </Grid>

                <TextBlock Style="{StaticResource L}" Text="Publish as"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="mode_new" GroupName="mode" IsChecked="True" Margin="0,0,18,0"
                                 Checked="on_mode"/>
                    <RadioButton x:Name="mode_update" GroupName="mode" Checked="on_mode"/>
                </StackPanel>
                <ComboBox x:Name="existing_box" Margin="0,6,0,0" IsEditable="True"
                          IsTextSearchEnabled="True" SelectionChanged="on_existing"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource L}" Text="ID = file name = family name in Revit (never changes)"/>
                        <TextBox x:Name="id_box"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource L}" Text="Group"/>
                        <ComboBox x:Name="group_box"/>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource L}" Text="Display name"/>
                <TextBox x:Name="name_box"/>
                <TextBlock Style="{StaticResource L}" Text="Tags (comma separated)"/>
                <TextBox x:Name="tags_box"/>
                <TextBlock Style="{StaticResource L}" Text="Description: when to use, what to fill in"/>
                <TextBox x:Name="desc_box" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock Style="{StaticResource L}" Text="Link to instructions (optional)"/>
                <TextBox x:Name="help_box"/>
                <TextBlock Style="{StaticResource L}" Text="What changed (goes to the history and What's new)"/>
                <TextBox x:Name="note_box"/>

                <TextBlock Style="{StaticResource L}" Text="Checks"/>
                <ListBox x:Name="results_list" MinHeight="90" MaxHeight="200" BorderBrush="#D6D3D1"/>
                <CheckBox x:Name="accept_box" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="status_text" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#44403C"/>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="publish_btn" Content="Publish" Style="{StaticResource Primary}"
                            Click="on_publish"/>
                    <Button x:Name="check_btn" Content="Check file" Style="{StaticResource Secondary}"
                            Click="on_check"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="csv_out_btn" Content="Info to Excel..." Style="{StaticResource Secondary}"
                            Click="on_csv_export" ToolTip="All family names, groups, tags, descriptions to a CSV for Excel"/>
                    <Button x:Name="csv_in_btn" Content="Info from Excel..." Style="{StaticResource Secondary}"
                            Click="on_csv_import" ToolTip="Apply the edited CSV: only changed fields, no new versions"/>
                    <Button x:Name="batch_btn" Content="Publish a sorted folder..."
                            Style="{StaticResource Secondary}" Margin="0" Click="on_batch"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
