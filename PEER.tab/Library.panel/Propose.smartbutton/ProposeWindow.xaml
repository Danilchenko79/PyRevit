<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - Propose a family"
        Height="720" Width="620" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <Window.Resources>
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#78716C"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="#111827" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn2" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource L}" Text="Where is the family"/>
                <RadioButton x:Name="src_file" GroupName="src" IsChecked="True" Checked="on_source"/>
                <Grid Margin="22,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="file_box"/>
                    <Button x:Name="browse_btn" Grid.Column="1" Content="Browse..." Style="{StaticResource Btn2}"
                            Margin="8,0,0,0" Padding="10,3" Click="on_browse"/>
                </Grid>
                <RadioButton x:Name="src_selected" GroupName="src" Checked="on_source"/>
                <RadioButton x:Name="src_editor" GroupName="src" Checked="on_source"/>
                <TextBlock x:Name="src_info" Margin="22,2,0,0" Foreground="#57534E" TextWrapping="Wrap"/>

                <TextBlock Style="{StaticResource L}" Text="Name"/>
                <TextBox x:Name="name_box"/>
                <TextBlock Style="{StaticResource L}" Text="Group"/>
                <ComboBox x:Name="group_box"/>

                <TextBlock Style="{StaticResource L}" Text="This is"/>
                <RadioButton x:Name="kind_new" GroupName="kind" IsChecked="True" Checked="on_kind"/>
                <RadioButton x:Name="kind_fix" GroupName="kind" Checked="on_kind"/>
                <ComboBox x:Name="existing_box" Margin="22,2,0,0" IsEditable="True"/>

                <TextBlock Style="{StaticResource L}" Text="Why is it needed"/>
                <TextBox x:Name="reason_box" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Style="{StaticResource L}" Text="Screenshot (optional, .png)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="shot_box"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource Btn2}"
                            Margin="8,0,0,0" Padding="10,3" Click="on_shot"/>
                </Grid>

                <TextBlock Style="{StaticResource L}" Text="Automatic checks (do not block sending)"/>
                <TextBlock x:Name="checks_text" TextWrapping="Wrap" Foreground="#44403C"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="status_text" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="send_btn" Content="Send to the admins" Style="{StaticResource Btn}"
                        Click="on_send"/>
                <Button Content="Check" Style="{StaticResource Btn2}" Margin="8,0,0,0" Click="on_check"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
