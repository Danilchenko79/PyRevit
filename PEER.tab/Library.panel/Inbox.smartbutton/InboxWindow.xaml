<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - Library inbox"
        Height="680" Width="1000" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <Window.Resources>
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="#111827" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn2" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CheckBox x:Name="show_done" Grid.Row="0" Margin="0,0,0,8" Checked="on_done" Unchecked="on_done"
                  Content="Show reviewed proposals too"/>
        <ListBox x:Name="list" Grid.Row="1" BorderBrush="#D6D3D1" Background="White"
                 SelectionChanged="on_select"/>
        <Border Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Background="White"
                BorderBrush="#D6D3D1" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <TextBlock x:Name="d_name" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="d_meta" Foreground="#57534E" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource L}" Text="Why"/>
                    <TextBlock x:Name="d_reason" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource L}" Text="Automatic checks"/>
                    <TextBlock x:Name="d_checks" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource L}" Text="Screenshot"/>
                    <Image x:Name="d_shot" MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource L}" Text="Comment for the author (required to reject)"/>
                    <TextBox x:Name="comment_box" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Padding="6,4"/>
                    <TextBlock x:Name="d_work" Margin="0,8,0,0" Foreground="#57534E" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <TextBlock x:Name="status_text" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="open_btn" Content="Open in the editor" Style="{StaticResource Btn2}"
                        Click="on_open"/>
                <Button x:Name="publish_btn" Content="Publish..." Style="{StaticResource Btn}"
                        Click="on_publish"/>
                <Button x:Name="reject_btn" Content="Reject" Style="{StaticResource Btn2}"
                        Click="on_reject"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
