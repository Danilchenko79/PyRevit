<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER Library - keys"
        Height="620" Width="760" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" PreviewKeyDown="on_key"
        Background="#F5F5F4" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="requests_box" Grid.Row="0" Margin="0,0,0,12" Background="#FFEDD5" BorderBrush="#7C2D12"
                BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock x:Name="requests_title" FontWeight="SemiBold" Foreground="#7C2D12"/>
                <ListBox x:Name="requests_list" Margin="0,8,0,0" MaxHeight="120" BorderBrush="#D6D3D1"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Approve as user" Padding="12,4" Foreground="White" Background="#14532D"
                            BorderBrush="#14532D" FontWeight="SemiBold" Click="on_approve_user"/>
                    <Button Content="Approve as admin" Padding="12,4" Margin="8,0,0,0" Background="White"
                            BorderBrush="#14532D" Click="on_approve_admin"/>
                    <Button Content="Decline" Padding="12,4" Margin="8,0,0,0" Background="White"
                            BorderBrush="#7F1D1D" Foreground="#7F1D1D" Click="on_decline"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D6D3D1" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Give a key to a person yourself"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="name_box" Padding="6,4" BorderBrush="#78716C"/>
                    <ComboBox x:Name="role_box" Grid.Column="1" Width="110" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="Create key" Margin="8,0,0,0" Padding="14,4"
                            Foreground="White" Background="#111827" BorderBrush="#111827"
                            FontWeight="SemiBold" Click="on_add"/>
                </Grid>
                <StackPanel x:Name="new_panel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Foreground="#7C2D12" FontWeight="SemiBold"
                               Text="The key is shown only now. Copy it and send it to the person privately (not in a group chat)."/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="new_key" IsReadOnly="True" Padding="6,4" FontFamily="Consolas"/>
                        <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Padding="14,4"
                                Background="White" BorderBrush="#111827" Click="on_copy"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,14,0,6" FontWeight="SemiBold" Text="Keys"/>
        <ListView x:Name="keys_list" Grid.Row="3" BorderBrush="#D6D3D1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding name}"/>
                    <GridViewColumn Header="Role" Width="70" DisplayMemberBinding="{Binding role}"/>
                    <GridViewColumn Header="State" Width="80" DisplayMemberBinding="{Binding state}"/>
                    <GridViewColumn Header="Last used" Width="140" DisplayMemberBinding="{Binding last_used}"/>
                    <GridViewColumn Header="Given" Width="140" DisplayMemberBinding="{Binding created}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="status_text" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Revoke selected key" Padding="14,6" Background="White"
                        BorderBrush="#7F1D1D" Foreground="#7F1D1D" FontWeight="SemiBold" Click="on_revoke"/>
                <Button Content="Refresh" Padding="14,6" Margin="8,0,0,0" Background="White"
                        BorderBrush="#111827" Click="on_refresh"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
