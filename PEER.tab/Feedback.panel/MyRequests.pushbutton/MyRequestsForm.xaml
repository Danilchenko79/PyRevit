<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - My requests"
        Height="520" Width="900" MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="My requests" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>

        <Border Grid.Row="1" Background="#F2F6FA" BorderBrush="#C6D4E1"
                BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#33475B">
                    <Run FontWeight="Bold" Text="How to use:"/><LineBreak/>
                    <Run Text="Requests sent from this computer with Contact, newest first. Status and comment are set by the head of the group: New, Accepted, In progress, Done, Rejected."/>
                </TextBlock>
                <TextBlock x:Name="lbl_note" TextWrapping="Wrap" Foreground="#33475B"
                           FontStyle="Italic" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="grid"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E3E8EE" Background="White"
                  BorderBrush="#BBBBBB" RowHeaderWidth="0"
                  SelectionMode="Single" SelectionUnit="FullRow"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Width="90" Height="28" Click="on_refresh" Margin="0,0,8,0"/>
            <Button Content="Close" Width="90" Height="28" Click="on_close"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
