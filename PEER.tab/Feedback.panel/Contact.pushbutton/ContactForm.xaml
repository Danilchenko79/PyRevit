<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - Contact"
        Height="640" Width="560" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <!-- All visible strings are set from script.py (lib/peer_feedback/texts.py). -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock x:Name="lbl_title" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>

                <Border Background="#F2F6FA" BorderBrush="#C6D4E1"
                        BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,4">
                    <TextBlock x:Name="lbl_howto" TextWrapping="Wrap" Foreground="#33475B"/>
                </Border>

                <TextBlock x:Name="lbl_topic" Margin="0,12,0,4"/>
                <ComboBox x:Name="cb_topic" SelectionChanged="on_topic_changed"/>
                <TextBlock x:Name="lbl_hint" Margin="2,4,0,0" FontSize="12"
                           Foreground="#5A6A78" TextWrapping="Wrap"/>

                <StackPanel x:Name="pnl_error">
                    <TextBlock x:Name="lbl_error" Margin="0,12,0,4"/>
                    <ComboBox x:Name="cb_error" SelectionChanged="on_error_changed"/>
                    <TextBlock x:Name="lbl_error_hint" Margin="2,4,0,0" FontSize="12"
                               Foreground="#5A6A78" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="pnl_button">
                    <TextBlock x:Name="lbl_button" Margin="0,12,0,4"/>
                    <ComboBox x:Name="cb_button" IsEditable="False"/>
                </StackPanel>

                <TextBlock x:Name="lbl_text" Margin="0,12,0,4"/>
                <TextBox x:Name="tb_text" Height="130"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lbl_frequency" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cb_frequency"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lbl_duration" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cb_duration"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="lbl_context" Margin="0,14,0,4"
                           FontSize="11" FontWeight="SemiBold" Foreground="#5A6A78"/>
                <TextBox x:Name="tb_context" IsReadOnly="True" IsTabStop="False"
                         Background="#FAFAFA" BorderBrush="#BBBBBB"
                         FontFamily="Consolas" FontSize="10" Foreground="#444444"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btn_ok" Width="90" Height="28" Click="on_ok"
                    Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="btn_cancel" Width="90" Height="28" Click="on_cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
