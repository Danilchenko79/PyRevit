<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEER - Contact"
        Height="760" Width="640" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        AllowDrop="True" DragOver="on_drag_over" Drop="on_drop"
        PreviewKeyDown="on_key"
        Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1F2937">
    <!-- All visible strings are set from script.py (lib/peer_feedback/texts.py).
         Topic / frequency / time pills and attachment thumbnails are created in code
         with the styles below (FindResource). -->
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE"/>
        <SolidColorBrush x:Key="Line" Color="#D8DEE6"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="14" Padding="12,5"
                                Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="6" Background="White"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{StaticResource Accent}" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="White" Padding="14,0"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Remove" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#CC1F2937">
                            <TextBlock Text="✕" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Padding="24,18,24,16">
            <StackPanel>
                <TextBlock x:Name="lbl_title" FontSize="20" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock x:Name="lbl_howto" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,16">
                <TextBlock x:Name="lbl_topic" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="pnl_topics"/>
                <TextBlock x:Name="lbl_hint" Style="{StaticResource Hint}" Margin="2,0,0,0"/>

                <StackPanel x:Name="pnl_error">
                    <TextBlock x:Name="lbl_error" Style="{StaticResource Label}"/>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <ComboBox x:Name="cb_error" SelectionChanged="on_error_changed"/>
                            <TextBlock x:Name="lbl_error_hint" Style="{StaticResource Hint}"
                                       Foreground="#991B1B" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="pnl_button">
                    <TextBlock x:Name="lbl_button" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="cb_button"/>
                </StackPanel>

                <TextBlock x:Name="lbl_text" Style="{StaticResource Label}"/>
                <Grid>
                    <TextBox x:Name="tb_text" Style="{StaticResource Input}" MinHeight="120"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" TextChanged="on_text_changed"/>
                    <TextBlock x:Name="lbl_placeholder" IsHitTestVisible="False"
                               Margin="11,8,11,0" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                </Grid>

                <!-- attachments -->
                <TextBlock x:Name="lbl_images" Style="{StaticResource Label}"/>
                <Border BorderBrush="#B6C2D1" BorderThickness="1" CornerRadius="6"
                        Background="#FAFBFC" Padding="10">
                    <StackPanel>
                        <WrapPanel x:Name="pnl_images"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="btn_add_image" DockPanel.Dock="Right" Height="28"
                                    Style="{StaticResource Secondary}" Click="on_add_image"/>
                            <TextBlock x:Name="lbl_images_hint" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="2,0,10,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lbl_frequency" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="pnl_frequency"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lbl_duration" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="pnl_duration"/>
                    </StackPanel>
                </Grid>

                <Expander x:Name="exp_context" Margin="0,14,0,0" Foreground="{StaticResource Muted}">
                    <TextBox x:Name="tb_context" IsReadOnly="True" IsTabStop="False"
                             Background="Transparent" BorderThickness="0" Margin="0,6,0,0"
                             FontFamily="Consolas" FontSize="11" Foreground="#4B5563"
                             TextWrapping="Wrap"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btn_cancel" Style="{StaticResource Secondary}" Height="34" MinWidth="90"
                            Margin="0,0,8,0" Click="on_cancel" IsCancel="True"/>
                    <Button x:Name="btn_ok" Style="{StaticResource Primary}" Height="34" MinWidth="110"
                            Click="on_ok"/>
                </StackPanel>
                <TextBlock x:Name="lbl_status" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
