<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tributary areas — settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Width" Value="70"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="12" Width="430">
    <TextBlock TextWrapping="Wrap" Foreground="#6b7385" Margin="0,0,0,8"
               Text="Starting values for new plans. Loads, slab thickness, supports and most of these values can also be changed in the plan itself."/>

    <GroupBox Header="Zones and supports">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Wall corner / end zone along the leg" ToolTip="Zone length = k · d_m from the face of the crossing wall"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="k_zone"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="· d_m"/>
        <TextBlock Grid.Row="1" Text="Column is at the edge if face to edge &lt;" ToolTip="edge_k · d_m"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="edge_k"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="· d_m"/>
        <TextBlock Grid.Row="2" Text="Free-standing wall is a pier if L ≤" ToolTip="pylon_ratio · t"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="pylon_ratio"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="· t"/>
        <TextBlock Grid.Row="3" Text="Grid step (smaller = more accurate, slower)"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="grid_mm"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="mm"/>
        <CheckBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="use_beams" Margin="0,4,0,0"
                  Content="Beams deeper than the slab are line supports"/>
      </Grid>
    </GroupBox>

    <GroupBox Header="Effective depth  d_m = h − c_nom − Ø">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Concrete cover c_nom"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="c_nom"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="mm"/>
        <TextBlock Grid.Row="1" Text="Top bar diameter Ø"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="bar_d"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm"/>
      </Grid>
    </GroupBox>

    <GroupBox Header="Punching check">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Concrete f_ck (cube)"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="fck"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="MPa"/>
        <TextBlock Grid.Row="1" Text="Top bars over supports Ø1 (0 = as Ø above)"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="top_d1"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm"/>
        <TextBlock Grid.Row="2" Text="   spacing s1"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="top_s1"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm"/>
        <TextBlock Grid.Row="3" Text="Additional top bars Ø2 (0 = none)"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="top_d2"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="mm"/>
        <TextBlock Grid.Row="4" Text="   spacing s2"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="top_s2"/>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="mm"/>
      </Grid>
    </GroupBox>

    <TextBlock x:Name="lblStatus" Foreground="#b3261e" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <DockPanel LastChildFill="False">
      <Button x:Name="btnDefaults" DockPanel.Dock="Left" Content="Defaults" Padding="10,3"/>
      <Button x:Name="btnCancel" DockPanel.Dock="Right" Content="Cancel" Padding="10,3" Margin="6,0,0,0" IsCancel="True"/>
      <Button x:Name="btnSave" DockPanel.Dock="Right" Content="Save" Padding="14,3" IsDefault="True"/>
    </DockPanel>
  </StackPanel>
</Window>
